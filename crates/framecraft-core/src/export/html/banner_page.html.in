<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@TITLE@</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: transparent;
    }
    .banner-root {
      position: relative;
      width: @WIDTH@px;
      height: @HEIGHT@px;
      margin: 0 auto;
      overflow: hidden;
      box-sizing: border-box;
    }
    #gfx {
      position: relative;
      width: 100%;
      height: 100%;
      opacity: 0;
      transform-origin: top left;
      box-sizing: border-box;
    }
    @FONT_FACE_CSS@
    .shapeItem { position: absolute; }
    .textItem { position: absolute; white-space: pre-wrap; overflow: hidden; line-height: 1.1; }
    .imgItem { position: absolute; object-fit: contain; }
    .imgSlotItem { position: absolute; }@OVERLAY_CSS@
  </style>
  @BOOT_SCRIPT@
  @BOARD_SCRIPT@
  @TEMPLATE_JS_SCRIPT@
  @CHART_SCRIPT@
  @QR_SCRIPT@
  @LOTTIE_SCRIPT@
  @VIDEO_SCRIPT@
  @MODULE_INIT_SCRIPT@
</head>
<body>
  <div class="banner-root">
    <div id="gfx">
@LAYERS@
    </div>
  </div>
</body>
</html>